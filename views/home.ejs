<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rise-Score | Rise & Recruit</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: "#020B24",
                        navy2: "#06143A",
                        blue: "#1264FF",
                        blue2: "#0B3FBF",
                        orange: "#FF8A00",
                        orange2: "#FF5E00"
                    }
                }
            }
        }
    </script>

    <style>
        * {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: #020B24;
            color: #F8FAFC;
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont,
                "Segoe UI", sans-serif;
        }

        .main-bg {
            background:
                radial-gradient(circle at 75% 18%,
                    rgba(18, 100, 255, 0.14),
                    transparent 30%),
                radial-gradient(circle at 85% 35%,
                    rgba(255, 138, 0, 0.07),
                    transparent 25%),
                #020B24;
        }

        .nav-bg {
            background: rgba(2, 11, 36, 0.88);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .blue-glow {
            box-shadow:
                0 0 30px rgba(18, 100, 255, 0.15),
                inset 0 0 30px rgba(18, 100, 255, 0.03);
        }

        .orange-glow {
            box-shadow:
                0 0 30px rgba(255, 138, 0, 0.16);
        }

        .hero-title {
            line-height: 0.98;
            letter-spacing: -0.045em;
        }

        .gradient-text {
            background: linear-gradient(90deg,
                    #1264FF,
                    #2D7BFF);

            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .orange-text {
            color: #FF8A00;
        }

        .blue-border {
            border-color: rgba(18, 100, 255, 0.45);
        }

        .card-bg {
            background: linear-gradient(145deg,
                    rgba(7, 23, 59, 0.96),
                    rgba(3, 14, 39, 0.98));
        }

        .card-bg:hover {
            background: linear-gradient(145deg,
                    rgba(8, 29, 75, 0.98),
                    rgba(4, 17, 47, 1));
        }

        .podium {
            background: linear-gradient(145deg,
                    #09275D,
                    #031333);

            border: 1px solid rgba(18, 100, 255, 0.55);
            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.4),
                inset 0 0 35px rgba(18, 100, 255, 0.08);
        }

        .podium-first {
            background: linear-gradient(145deg,
                    #0A347C,
                    #04183D);
        }

        .feature-icon {
            background: rgba(18, 100, 255, 0.10);
            border: 1px solid rgba(18, 100, 255, 0.55);
        }

        .orange-icon {
            background: rgba(255, 138, 0, 0.08);
            border: 1px solid rgba(255, 138, 0, 0.55);
        }

        .section-line {
            background: linear-gradient(90deg,
                    #1264FF,
                    #FF8A00);
        }

        .cta {
            background:
                radial-gradient(circle at 80% 50%,
                    rgba(18, 100, 255, 0.20),
                    transparent 40%),
                linear-gradient(120deg,
                    #06194A,
                    #04102E);
        }

        .stat-card {
            background: rgba(5, 20, 52, 0.75);
        }

        .floating {
            animation: floating 4s ease-in-out infinite;
        }

        @keyframes floating {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        .pulse-dot {
            animation: pulseDot 2s infinite;
        }

        @keyframes pulseDot {

            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(18, 100, 255, 0.5);
            }

            50% {
                box-shadow: 0 0 0 8px rgba(18, 100, 255, 0);
            }
        }

        .grid-lines {
            background-image:
                linear-gradient(rgba(18, 100, 255, 0.035) 1px,
                    transparent 1px),
                linear-gradient(90deg,
                    rgba(18, 100, 255, 0.035) 1px,
                    transparent 1px);

            background-size: 55px 55px;
        }
